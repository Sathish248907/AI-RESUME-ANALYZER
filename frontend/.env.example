# ── Backend API (public — no secrets here) ───────────────────────────────────
# Base URL of the Express backend (backend/). Reaches the browser, so never put
# anything secret behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override used by the legacy route handlers when they verify a
# bearer token against the backend. Useful when the backend is reachable on a
# private network address that the browser cannot use. Defaults to
# NEXT_PUBLIC_API_URL.
BACKEND_INTERNAL_URL=

# ── Legacy Phase 1 routes: /analyze and /history ─────────────────────────────
# These two route handlers run server-side inside Next.js and talk to the
# `legacy` schema of the same database — the backend owns every api_* table.
# The connection string MUST end with ?schema=legacy.
#
# Leave both blank to run backend-only: /analyze and /history then stop working
# and nothing else is affected.
#
# Note: there is deliberately no db:push or db:migrate script in package.json.
# frontend/prisma/schema.prisma knows nothing about the backend's 55 tables, so
# pushing it at this URL would offer to drop them.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resume_analyzer?schema=legacy

# Gemini is called directly by /api/analyze (the public, no-sign-in analysis).
# Input size is capped and the route is rate limited, but this key does spend
# money for anonymous visitors — leave it unset if you do not want that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Removed in Phase 15 ──────────────────────────────────────────────────────
# NEXTAUTH_SECRET, NEXTAUTH_URL, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are gone: NextAuth was removed. It
# had no users, was unreachable from the UI, carried two critical advisories,
# and its GOOGLE_* names collided with the backend's own OAuth client.
# Authentication is the backend's JWT. Delete these from any deployed
# environment that still has them.
