# ── Backend API (public — no secrets here) ───────────────────────────────────
# Base URL of the Express backend (backend/). Used by src/services/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Legacy Next.js API routes (Phase 1: /analyze page, /api/analyze, /api/history) ──
# These run server-side inside Next.js and are optional. Leave empty to use the
# backend-only flow. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resume_analyzer
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GEMINI_API_KEY=
