// Legacy (Phase 1) schema for the public /analyze page and /history.
//
// These models live in the `legacy` schema of the same database (the connection
// string carries ?schema=legacy); the Express backend owns every `api_*` table
// through backend/prisma/schema.prisma and its migrations. Nothing here is
// managed by a migration, and there is deliberately no db:push or db:migrate
// script in package.json: running one against the production URL would offer to
// reset tables this file knows nothing about.
//
// The NextAuth models (Account, Session, VerificationToken) were removed in
// Phase 15 along with next-auth itself. Authentication is the backend's JWT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analyses  Analysis[]
  resumes   Resume[]
}




model Resume {
  id        String   @id @default(cuid())
  userId    String?
  fileName  String
  fileSize  Int
  mimeType  String
  text      String   @db.Text
  createdAt DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  analyses Analysis[]
}

model Analysis {
  id             String   @id @default(cuid())
  userId         String?
  resumeId       String
  jobTitle       String
  jobDescription String   @db.Text
  matchScore     Int
  result         Json
  createdAt      DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}
