# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Origin allowed by CORS (the Next.js frontend). Comma-separate several origins if needed.
FRONTEND_URL=http://localhost:3001

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resume_analyzer?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── LLM provider ─────────────────────────────────────────────────────────────
# anthropic | gemini
LLM_PROVIDER=anthropic
# API key for the selected provider. Never expose this to the browser.
LLM_API_KEY=
# anthropic default: claude-opus-5-5 · gemini examples: gemini-flash-latest (free tier: 20 requests/day/model), gemini-flash-lite-latest (separate, larger free quota)
LLM_MODEL=claude-opus-5-5
# Per-request timeout for the provider call, in milliseconds
LLM_TIMEOUT_MS=90000
# Number of retries on transient provider errors (429 / 5xx / network)
LLM_MAX_RETRIES=2

# ── Limits ───────────────────────────────────────────────────────────────────
# Requests per 15 minutes per IP for the analysis endpoint
ANALYSIS_RATE_LIMIT=10
# Keep extracted resume text in the database (false by default — only derived results are stored)
STORE_RESUME_TEXT=false

# ── Resume file storage (Phase 5) ────────────────────────────────────────────
# none  = original files are discarded after text extraction (default)
# local = originals kept under STORAGE_LOCAL_DIR with random names; downloadable by owner only
STORAGE_DRIVER=none
STORAGE_LOCAL_DIR=uploads/private

# ── Job providers (Phase 12) ─────────────────────────────────────────────────
# Comma-separated adapter slugs to enable. Leave empty for no external provider:
# job discovery then serves only the jobs you enter yourself and shows a setup guide.
#   remotive   — remote jobs, no credentials, attribution required
#   arbeitnow  — job board API, no credentials, attribution required
#   adzuna     — needs ADZUNA_APP_ID + ADZUNA_APP_KEY (free developer tier)
#   jooble     — needs JOOBLE_API_KEY
# Example: JOB_PROVIDERS=remotive,arbeitnow
JOB_PROVIDERS=
# Per-request timeout for a provider call, in milliseconds
JOB_PROVIDER_TIMEOUT_MS=8000
# How long a cached listing may be served before it is refetched
JOB_CACHE_TTL_MINUTES=30
# Cached third-party listings older than this are deleted (provider retention terms)
JOB_RETENTION_DAYS=30
# Outbound calls allowed per provider per minute
JOB_PROVIDER_RATE_LIMIT_PER_MIN=20

# Adzuna — register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ISO country code for the Adzuna endpoint (gb, us, in, de, …)
ADZUNA_COUNTRY=gb

# Jooble — request a key at https://jooble.org/api/about
JOOBLE_API_KEY=

# ─── Phase 14: integrations & workflow automation ────────────────────────────
# Required before any OAuth integration can be connected. Without it the token
# vault refuses to operate and Google Calendar / Drive stay disconnected — there
# is no plaintext fallback. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Google OAuth client (Calendar + Drive share one client).
# Create a project at https://console.cloud.google.com/, enable the Google
# Calendar API and the Google Drive API, then create an OAuth 2.0 Client ID of
# type "Web application" and register this exact redirect URI:
#   http://localhost:4000/api/integrations/callback
# Scopes requested are the narrowest that work: calendar.events and drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery. "log" records every message so you can read exactly what would
# have been sent, and delivers nothing — the UI says so rather than implying mail
# is arriving. This build ships no mail client library on purpose: switching to
# "smtp" also requires installing one and implementing createSmtpTransport in
# backend/src/services/integrations/emailService.js.
EMAIL_TRANSPORT=log
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Authentication attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
