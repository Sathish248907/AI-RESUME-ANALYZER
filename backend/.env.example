# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Origin allowed by CORS (the Next.js frontend). Comma-separate several origins if needed.
FRONTEND_URL=http://localhost:3001

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resume_analyzer?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── LLM provider ─────────────────────────────────────────────────────────────
# anthropic | gemini
LLM_PROVIDER=anthropic
# API key for the selected provider. Never expose this to the browser.
LLM_API_KEY=
# anthropic default: claude-opus-5-5 · gemini example: gemini-1.5-flash
LLM_MODEL=claude-opus-5-5
# Per-request timeout for the provider call, in milliseconds
LLM_TIMEOUT_MS=90000
# Number of retries on transient provider errors (429 / 5xx / network)
LLM_MAX_RETRIES=2

# ── Limits ───────────────────────────────────────────────────────────────────
# Requests per 15 minutes per IP for the analysis endpoint
ANALYSIS_RATE_LIMIT=10
# Keep extracted resume text in the database (false by default — only derived results are stored)
STORE_RESUME_TEXT=false
