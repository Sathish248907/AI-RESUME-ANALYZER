// Backend schema for the AI Resume Analyzer API.
// Table names are mapped with a prefix so this schema can share a database
// with the Next.js (NextAuth) schema without colliding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  analyses              Analysis[]
  resumes               Resume[]
  jobDescriptions       JobDescription[]
  applications          JobApplication[]
  interviewSessions     InterviewSession[]
  roadmaps              LearningRoadmap[]
  skillGaps             SkillGap[]
  dismissals            RecommendationDismissal[]
  resumeVersions        ResumeVersion[]
  templatePreference    ResumeTemplatePreference?
  atsAssessments        ResumeAtsAssessment[]
  roleRecommendations   ResumeRoleRecommendation[]
  careerProfile         CareerProfile?
  careerAssessments     CareerAssessment[]
  careerRecommendations CareerRecommendation[]
  careerActionPlans     CareerActionPlan[]
  careerActionTasks     CareerActionTask[]
  coachConversations    CareerCoachConversation[]
  progressSnapshots     CareerProgressSnapshot[]
  gamificationProfile   GamificationProfile?
  pointTransactions     PointTransaction[]
  achievements          UserAchievement[]
  goals                 UserGoal[]
  activityEvents        ActivityEvent[]
  progressReports       ProgressReport[]
  notifications         UserNotification[]
  savedJobs             SavedJob[]
  jobSearchPreference   JobSearchPreference?
  jobMatchReports       JobMatchReport[]
  jobAlerts             JobAlert[]
  checklistItems        ApplicationChecklistItem[]
  coverLetters          CoverLetter[]
  applicationDocuments  ApplicationDocument[]
  applicationActivities ApplicationActivity[]
  applicationReminders  ApplicationReminder[]
  applicationInterviews ApplicationInterview[]
  integrations          ExternalIntegration[]
  pendingAuthorizations PendingAuthorization[]
  integrationSyncLogs   IntegrationSyncLog[]
  calendarEvents        ExternalCalendarEvent[]
  fileExports           ExternalFileExport[]
  automationRules       AutomationRule[]
  automationExecutions  AutomationExecution[]
  emailDeliveries       EmailDelivery[]
  onboarding            UserOnboarding?

  @@map("api_users")
}

/// An uploaded resume. The extracted text is retained so the resume can be
/// re-analysed against other job descriptions; it is only ever returned to its
/// owner and never to list endpoints. Original files are kept only when a
/// storage driver is configured (STORAGE_DRIVER), referenced by an opaque key.
model Resume {
  id               String   @id @default(cuid())
  userId           String
  name             String
  originalFileName String
  fileType         String
  fileSize         Int
  charCount        Int
  extractedText    String   @db.Text
  targetRole       String?
  storageKey       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  applications JobApplication[]
  versions     ResumeVersion[]

  @@index([userId, createdAt])
  @@index([userId, name])
  @@map("api_resumes")
}

/// A saved job description that can be reused across resumes and applications.
model JobDescription {
  id                    String   @id @default(cuid())
  userId                String
  jobTitle              String
  companyName           String?
  targetRole            String
  description           String   @db.Text
  sourceUrl             String?
  /// Structured requirements extracted client-side (Phase 3 parser) or by the AI.
  extractedRequirements Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses        Analysis[]
  applications    JobApplication[]
  resumeVersions  ResumeVersion[]
  atsAssessments  ResumeAtsAssessment[]
  savedJobs       SavedJob[]
  jobMatchReports JobMatchReport[]

  @@index([userId, createdAt])
  @@index([userId, targetRole])
  @@map("api_job_descriptions")
}

/// ResumeAnalysis — one analysis run. Historical runs are preserved; regeneration
/// creates a new row rather than overwriting.
model Analysis {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  jobTitle         String
  targetRole       String
  companyName      String?
  fileName         String?
  analysisMode     String   @default("ai") // "ai" | "demo"
  matchScore       Int
  provider         String?
  model            String?
  /// Validated, structured analysis result (see validators/analysisSchemas.js)
  result           Json
  /// Inputs needed to regenerate the analysis. Resume text is only stored when STORE_RESUME_TEXT=true
  /// and no Resume row is linked.
  jobDescription   String   @db.Text
  resumeText       String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume            Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescriptionRef JobDescription?  @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  applications      JobApplication[]

  @@index([userId, createdAt])
  @@index([userId, matchScore])
  @@index([userId, targetRole])
  @@index([resumeId])
  @@index([jobDescriptionId])
  @@map("api_analyses")
}

enum ApplicationStatus {
  INTERESTED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id                  String            @id @default(cuid())
  userId              String
  jobDescriptionId    String?
  resumeId            String?
  analysisId          String?
  companyName         String
  jobTitle            String
  jobUrl              String?
  applicationDate     DateTime          @default(now())
  status              ApplicationStatus @default(INTERESTED)
  nextFollowUpDate    DateTime?
  /// Phase 13, additive: the final outcome once an offer exists (accepted |
  /// declined). Kept off ApplicationStatus so the Phase 9/10 funnel and
  /// ACTIVE_STATUSES keep their existing meaning.
  outcome             String?
  applicationDeadline DateTime?
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription?            @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resume         Resume?                    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  analysis       Analysis?                  @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  savedJobs      SavedJob[]
  checklistItems ApplicationChecklistItem[]
  coverLetters   CoverLetter[]
  documents      ApplicationDocument[]
  activities     ApplicationActivity[]
  reminders      ApplicationReminder[]
  interviews     ApplicationInterview[]

  @@index([userId, status])
  @@index([userId, applicationDate])
  @@index([userId, nextFollowUpDate])
  @@index([userId, companyName])
  @@map("api_job_applications")
}

model InterviewSession {
  id                     String    @id @default(cuid())
  userId                 String
  targetRole             String
  interviewType          String    @default("mixed") // technical | hr | coding | resume_based | behavioral | mixed | project
  difficulty             String    @default("intermediate") // beginner | intermediate | advanced
  durationMinutes        Int?
  /// totalQuestions (spec name) — number of generated questions
  questionCount          Int
  /// answeredQuestions (spec name) — answers submitted or skipped
  completedQuestionCount Int       @default(0)
  /// overallScore (spec name) — mean of evaluated answer scores, null until completed
  score                  Int?
  durationSeconds        Int?
  status                 String    @default("in_progress") // in_progress | completed | abandoned
  scoringRubricVersion   String?
  /// Personalisation inputs (ids only; the text is read from the owning rows at generation time)
  analysisId             String?
  resumeId               String?
  jobDescriptionId       String?
  topics                 Json?
  /// Lightweight log entries created from the analysis Interview tab (Phase 5) have source = "practice_log"
  source                 String    @default("mock_interview")
  startedAt              DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions             InterviewQuestion[]
  answers               InterviewAnswer[]
  applicationInterviews ApplicationInterview[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, targetRole])
  @@map("api_interview_sessions")
}

/// A generated question. `evaluationCriteria` is private to the backend and is never
/// returned to the client before the answer has been evaluated.
model InterviewQuestion {
  id                   String   @id @default(cuid())
  sessionId            String
  orderIndex           Int
  questionText         String   @db.Text
  category             String
  topic                String
  difficulty           String
  questionType         String // conceptual | technical | project | scenario | behavioral | coding
  evaluationCriteria   Json
  suggestedTimeSeconds Int      @default(180)
  createdAt            DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer  InterviewAnswer?

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@map("api_interview_questions")
}

/// The candidate's answer and its evaluation. Deleting the session deletes answers (retention policy:
/// answers live exactly as long as their session; users delete sessions from the interview history).
model InterviewAnswer {
  id                  String    @id @default(cuid())
  sessionId           String
  questionId          String    @unique
  answerText          String    @db.Text
  programmingLanguage String?
  status              String    @default("draft") // draft | submitted | evaluating | evaluated | insufficient | skipped | failed
  evaluationResult    Json?
  score               Int?
  rubricVersion       String?
  submittedAt         DateTime?
  evaluatedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("api_interview_answers")
}

// ─── Phase 7: Learning roadmap & skill gaps ──────────────────────────────────

/// A generated learning plan. Regeneration creates a new version row and marks the
/// previous one `superseded` (its id is kept in previousVersionId for history).
model LearningRoadmap {
  id                        String    @id @default(cuid())
  userId                    String
  targetRole                String
  title                     String
  objective                 String // job_readiness | interview_prep | project_development | skill_improvement
  currentSkillLevel         String // beginner | intermediate | advanced
  weeklyStudyHours          Int
  preferredSchedule         String    @default("flexible") // weekdays | weekends | flexible
  preferredFormat           String    @default("mixed") // documentation | tutorials | exercises | projects | mixed
  targetCompletionDate      DateTime?
  estimatedHours            Int       @default(0)
  estimatedWeeks            Int       @default(0)
  status                    String    @default("active") // active | archived | superseded
  version                   Int       @default(1)
  previousVersionId         String?
  changeSummary             Json?
  skillGapSummary           Json?
  sourceResumeId            String?
  sourceJobDescriptionId    String?
  sourceAnalysisId          String?
  sourceInterviewSessionIds Json?
  provider                  String?
  model                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones RoadmapMilestone[]
  skillGaps  SkillGap[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("api_learning_roadmaps")
}

model RoadmapMilestone {
  id                    String    @id @default(cuid())
  roadmapId             String
  sequenceNumber        Int
  title                 String
  description           String    @db.Text
  requiredSkills        Json // string[]
  learningObjectives    Json // string[]
  estimatedHours        Int       @default(0)
  /// sequenceNumbers of milestones that must be completed first (validated to reference earlier milestones)
  prerequisiteSequences Json // number[]
  completionCriteria    String    @db.Text
  status                String    @default("not_started") // locked | not_started | in_progress | completed
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  roadmap LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks   LearningTask[]

  @@unique([roadmapId, sequenceNumber])
  @@index([roadmapId, status])
  @@map("api_roadmap_milestones")
}

model LearningTask {
  id                 String    @id @default(cuid())
  milestoneId        String
  sequenceNumber     Int
  title              String
  description        String    @db.Text
  skillName          String
  taskType           String // learn_concept | read_docs | tutorial | coding_exercise | mini_project | review_interview_questions | explain_concept | knowledge_checkpoint
  difficulty         String    @default("intermediate")
  estimatedMinutes   Int       @default(30)
  isRequired         Boolean   @default(true)
  scheduledDate      DateTime?
  completionCriteria String    @db.Text
  status             String    @default("not_started") // not_started | in_progress | paused | completed | skipped
  notes              String?   @db.Text
  actualStudyMinutes Int       @default(0)
  /// For knowledge_checkpoint tasks: { id, type: mcq|conceptual|coding|project|checklist, passScore?, questions?[...], items?[...] }.
  /// Correct answers are stripped before being sent to the client until an attempt is submitted.
  checkpoint         Json?
  checkpointAttempts Json? // attempt history [{ at, score, passed, answers }]
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  milestone RoadmapMilestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  resources LearningResource[]

  @@unique([milestoneId, sequenceNumber])
  @@index([milestoneId, status])
  @@index([scheduledDate])
  @@map("api_learning_tasks")
}

/// Resources attached to a task. URLs are only stored when they come from the verified
/// catalog (`urlVerified = true`); otherwise only a title / search suggestion is kept.
model LearningResource {
  id           String   @id @default(cuid())
  taskId       String
  title        String
  resourceType String // official_docs | tutorial | video_course | practice_platform | project_example | interview_prep | search_suggestion
  url          String?
  urlVerified  Boolean  @default(false)
  provider     String   @default("third_party") // official | third_party | search
  description  String   @db.Text
  difficulty   String   @default("intermediate")
  createdAt    DateTime @default(now())

  task LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("api_learning_resources")
}

/// Persistent per-user skill status, refreshed whenever a roadmap is generated and
/// editable by the user ("I already know this").
model SkillGap {
  id                String    @id @default(cuid())
  userId            String
  roadmapId         String?
  skillName         String
  category          String
  proficiencyStatus String // demonstrated | needs_improvement | not_demonstrated | not_assessed | learning_in_progress
  priority          String // high | medium | low
  priorityScore     Int       @default(0)
  evidenceSources   Json // string[]
  explanation       String    @db.Text
  whyItMatters      String    @db.Text
  targetProficiency String    @default("working")
  relatedTopics     Json? // string[]
  userConfirmed     Boolean   @default(false)
  userNote          String?
  lastAssessedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap LearningRoadmap? @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@unique([userId, skillName])
  @@index([userId, priorityScore])
  @@map("api_skill_gaps")
}

model RecommendationDismissal {
  id                String   @id @default(cuid())
  userId            String
  recommendationKey String
  dismissedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationKey])
  @@map("api_recommendation_dismissals")
}

// ─── Phase 8: resume builder ───────────────────────────────────────────────

/// An editable, structured resume. The uploaded file and its extracted text on
/// `Resume` are never modified; every edit lives on a version. `content` holds
/// the ordered sections (see services/resumeBuilder/resumeContentSchema.js) and
/// `formatting` the template options. Searchable metadata stays in columns.
model ResumeVersion {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  parentVersionId  String?
  name             String
  versionNumber    Int
  kind             String   @default("custom") // original | improved | tailored | custom | restored
  isOriginal       Boolean  @default(false)
  templateId       String   @default("modern")
  content          Json
  formatting       Json
  contentSource    String   @default("manual") // manual | heuristic | ai | duplicate | restore
  targetJobTitle   String?
  targetCompany    String?
  lastQualityScore Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume              Resume?                    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescription      JobDescription?            @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  improvements        ResumeImprovement[]
  atsAssessments      ResumeAtsAssessment[]
  roleRecommendations ResumeRoleRecommendation[]
  jobMatchReports     JobMatchReport[]
  coverLetters        CoverLetter[]

  @@index([userId, updatedAt])
  @@index([resumeId, versionNumber])
  @@map("api_resume_versions")
}

/// One AI suggestion for one field. Suggestions are stored separately from the
/// resume content and only reach the content when the user accepts them.
model ResumeImprovement {
  id                   String    @id @default(cuid())
  versionId            String
  batchId              String
  mode                 String // improve | tailor
  sectionId            String
  entryId              String?
  field                String // summary | bullet:<index> | title | skills | ...
  category             String // clarity | impact | grammar | keywords | structure | relevance
  /// Which panel group the suggestion belongs to: summary | skills | experience |
  /// projects | education | achievements | keywords | grammar | formatting | ats.
  suggestionGroup      String?
  priority             String    @default("medium") // high | medium | low
  /// Card presentation, supplied by the model and backfilled deterministically.
  title                String?
  issue                String?   @db.Text
  benefit              String?   @db.Text
  originalText         String    @db.Text
  suggestedText        String    @db.Text
  rationale            String    @db.Text
  needsConfirmation    Boolean   @default(false)
  confirmationQuestion String?
  status               String    @default("pending") // pending | accepted | rejected | edited
  acceptedText         String?   @db.Text
  /// How many times the user asked for a different take on this field.
  regenerationCount    Int       @default(0)
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())

  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, batchId])
  @@index([versionId, status])
  @@map("api_resume_improvements")
}

/// The user's default template and formatting for new versions.
model ResumeTemplatePreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  templateId String   @default("modern")
  formatting Json
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_resume_template_preferences")
}

/// A point-in-time ATS-readiness assessment of one resume version, kept so the
/// user can see whether their edits actually moved the score. The breakdown is
/// stored with it because the weights are configurable: a historical score must
/// stay explainable by the model that produced it, not by today's weights.
/// `mode` distinguishes a general assessment from one scored against a job, so
/// the two are never plotted as one series.
model ResumeAtsAssessment {
  id               String   @id @default(cuid())
  userId           String
  versionId        String
  jobDescriptionId String?
  mode             String // general | job
  overallScore     Int
  label            String
  jobTitle         String?
  targetRole       String?
  templateId       String?
  /// Per-category scores, weights and explanations as returned at the time.
  categories       Json
  /// The findings and ordered action plan for this run.
  findings         Json
  keywordCoverage  Json?
  skills           Json?
  weights          Json
  method           String
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  version        ResumeVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([versionId, mode, createdAt])
  @@map("api_resume_ats_assessments")
}

/// A role-suitability run for one resume version. Stored so the "Recommended
/// roles" panel does not have to recompute on every page load, and so choosing
/// a target role is auditable: `selectedRole` records which role the user
/// adopted from this run. The authoritative list of target roles stays on
/// CareerProfile — this is a record of the recommendation, not a second source.
model ResumeRoleRecommendation {
  id           String   @id @default(cuid())
  userId       String
  versionId    String
  /// The full scored role cards, including the evidence each score came from.
  roles        Json
  careerLevel  String?
  selectedRole String?
  method       String
  createdAt    DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([versionId, createdAt])
  @@map("api_resume_role_recommendations")
}

// ─── Phase 9: career coach ─────────────────────────────────────────────────

/// What the user tells us about their goals. Nothing here is inferred.
model CareerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  careerLevel       String   @default("fresher") // student | fresher | junior | mid | experienced
  targetRoles       Json // string[]
  industries        Json // string[]
  skills            Json // string[] — self-declared, kept separate from evidence-based skill gaps
  locations         Json // string[]
  workMode          String   @default("any") // remote | hybrid | onsite | any
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  goals             String?  @db.Text
  learningInterests Json // string[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_career_profiles")
}

/// A readiness assessment for one target role. Scores are derived from records (method versioned).
model CareerAssessment {
  id              String   @id @default(cuid())
  userId          String
  targetRole      String
  overallScore    Int
  readinessLabel  String
  components      Json // [{ key, label, weight, score, evidence[], missing[] }]
  skills          Json // [{ skillName, status, score, evidence[] }]
  strengths       Json // string[]
  improvements    Json // string[]
  missingEvidence Json // string[]
  nextActions     Json // [{ title, href, reason }]
  sources         Json // { resumes, analyses, interviews, roadmaps, applications, versions }
  method          String
  createdAt       DateTime @default(now())

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations CareerRecommendation[]

  @@index([userId, createdAt])
  @@index([userId, targetRole])
  @@map("api_career_assessments")
}

/// Evidence-backed recommendation with completion state. `key` is stable so regeneration updates instead of duplicating.
model CareerRecommendation {
  id            String    @id @default(cuid())
  userId        String
  assessmentId  String?
  key           String
  type          String // resume | interview | learning | project | application | skill | profile
  title         String
  explanation   String    @db.Text
  reason        String    @db.Text
  evidence      Json // string[]
  priority      String    @default("medium") // high | medium | low
  effortMinutes Int?
  href          String
  status        String    @default("open") // open | done | dismissed
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment CareerAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([userId, status, priority])
  @@map("api_career_recommendations")
}

model CareerActionPlan {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  weekEnd     DateTime
  status      String   @default("active") // active | archived
  targetRole  String?
  summary     Json // { totalMinutes, byCategory, sources }
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks CareerActionTask[]

  @@index([userId, status])
  @@index([userId, weekStart])
  @@map("api_career_action_plans")
}

model CareerActionTask {
  id               String    @id @default(cuid())
  planId           String
  userId           String
  title            String
  description      String?   @db.Text
  category         String // learning | interview | resume | application | personal
  href             String?
  estimatedMinutes Int       @default(30)
  dueDate          DateTime?
  isOptional       Boolean   @default(false)
  sourceKey        String? // recommendation key / roadmap task id / application id — prevents duplicates across regenerations
  status           String    @default("pending") // pending | done | skipped
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plan CareerActionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@index([userId, dueDate])
  @@map("api_career_action_tasks")
}

model CareerCoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CareerCoachMessage[]

  @@index([userId, updatedAt])
  @@map("api_career_coach_conversations")
}

model CareerCoachMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String   @db.Text
  factsUsed      Json? // string[] — recorded facts the reply relied on
  suggestions    Json? // string[] — AI-generated suggestions (not facts)
  links          Json? // [{ label, path }]
  clarifying     Boolean  @default(false)
  provider       String?
  model          String?
  createdAt      DateTime @default(now())

  conversation CareerCoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("api_career_coach_messages")
}

// ─── Phase 10: analytics, gamification & progress intelligence ──────────────

/// One career-progress score per user per local day (dayKey = YYYY-MM-DD in the user's
/// timezone). Stored so trends compare like with like; recomputing on the same day updates in place.
model CareerProgressSnapshot {
  id           String   @id @default(cuid())
  userId       String
  dayKey       String
  overallScore Int?
  dimensions   Json // [{ key, label, weight, score, included, evidence[], explanation }]
  coverage     Json // { included, total, weightUsed }
  method       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId, createdAt])
  @@map("api_career_progress_snapshots")
}

/// Points / level / streak summary. Totals are always re-derived from PointTransaction rows
/// (never accepted from the client). `timezone` is the IANA zone used for streak day boundaries.
model GamificationProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  totalPoints             Int       @default(0)
  level                   Int       @default(1)
  timezone                String    @default("UTC")
  currentStreak           Int       @default(0)
  longestStreak           Int       @default(0)
  lastActivityDay         String?
  notificationPreferences Json? // { achievements, levels, reports, goals, milestones, assessments }
  lastReconciledAt        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_gamification_profiles")
}

/// Auditable ledger. `eventKey` identifies the real-world activity (e.g. learning_task_completed:<taskId>);
/// `kind` is award or reversal and `cycle` increments each time the same activity is re-awarded
/// after a reversal, so the unique constraint blocks duplicate rewards.
model PointTransaction {
  id         String   @id @default(cuid())
  userId     String
  eventKey   String
  eventType  String
  kind       String // award | reversal
  cycle      Int      @default(1)
  points     Int
  sourceType String?
  sourceId   String?
  title      String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey, kind, cycle])
  @@index([userId, createdAt])
  @@index([userId, eventType])
  @@map("api_point_transactions")
}

/// Unlock record. Achievement definitions (criteria) live in services/progress/progressConfig.js;
/// the unique constraint prevents a second unlock of the same key.
model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementKey String
  unlockedAt     DateTime @default(now())
  progressValue  Int
  targetValue    Int
  evidence       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId, unlockedAt])
  @@map("api_user_achievements")
}

/// A personal career-development goal. `currentValue` is recomputed from linked records
/// (goalType + linkKey) and `baselineValue` is the value at creation so progress counts only new activity.
model UserGoal {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?   @db.Text
  goalType      String // mock_interviews | learning_tasks | roadmap_completion | resume_quality | skill_practice | applications | custom
  linkKey       String? // roadmapId / skillName / resumeId / targetRole depending on goalType
  targetValue   Int
  baselineValue Int       @default(0)
  currentValue  Int       @default(0)
  unit          String    @default("count")
  targetDate    DateTime?
  status        String    @default("active") // active | paused | completed | archived
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, targetDate])
  @@map("api_user_goals")
}

/// Activity history entry (what the user did, when). Derived from persisted records; one row per eventKey.
model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String
  eventKey   String
  eventType  String
  title      String
  category   String // learning | interview | resume | application | career | gamification
  points     Int      @default(0)
  href       String?
  occurredAt DateTime
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, occurredAt])
  @@map("api_activity_events")
}

/// Weekly / monthly progress report. Metrics are deterministic; `narrative` is the optional AI summary
/// (clearly labelled) and `aiUsed` records whether the provider contributed.
model ProgressReport {
  id          String   @id @default(cuid())
  userId      String
  periodType  String // weekly | monthly
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  narrative   Json? // { summary, highlights[], priorities[], source: "ai" | "deterministic" }
  aiUsed      Boolean  @default(false)
  provider    String?
  model       String?
  method      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodStart])
  @@index([userId, createdAt])
  @@map("api_progress_reports")
}

/// In-app notification. `dedupeKey` prevents a second notification for the same event.
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String // achievement | level | milestone | assessment | report | goal | streak
  title     String
  body      String    @db.Text
  href      String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("api_user_notifications")
}

// ─── Phase 12: job discovery & intelligent job matching ──────────────────────

/// A configured job source. These rows are bookkeeping for the code-defined
/// adapters — credentials live in environment variables and are never stored
/// here. Attribution text required by a provider's terms is kept so the UI can
/// display it.
model JobProvider {
  slug          String    @id
  displayName   String
  attribution   String?
  termsUrl      String?
  lastFetchedAt DateTime?
  lastStatus    String?
  lastError     String?
  lastJobCount  Int       @default(0)
  requestCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs ExternalJob[]

  @@map("api_job_providers")
}

/// One normalized listing fetched from a provider. Deliberately NOT user-scoped:
/// it is cached third-party data subject to JOB_RETENTION_DAYS, kept separate
/// from anything the user writes (their state lives on SavedJob). Manually
/// entered jobs are not stored here — they reuse JobDescription.
model ExternalJob {
  id               String    @id @default(cuid())
  providerSlug     String
  externalId       String
  /// sha1(title|company|location) — collapses the same vacancy across providers.
  fingerprint      String
  title            String
  companyName      String
  companyLogoUrl   String?
  location         String?
  isRemote         Boolean   @default(false)
  /// remote | hybrid | onsite | unknown — "unknown" when the source does not say.
  workArrangement  String    @default("unknown")
  /// full_time | part_time | contract | internship | temporary | unknown
  employmentType   String    @default("unknown")
  /// entry | junior | mid | senior | lead | unknown
  experienceLevel  String    @default("unknown")
  description      String    @db.Text
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?
  salaryPeriod     String?
  salaryIsEstimate Boolean   @default(false)
  /// Set only when the provider marks a listing as promoted. Never boosts rank.
  isSponsored      Boolean   @default(false)
  /// Only set when the provider supplies a timestamp; postedAtReliable says
  /// whether it may be used for freshness ranking and date filtering.
  postedAt         DateTime?
  postedAtReliable Boolean   @default(false)
  sourceUrl        String?
  applyUrl         String?
  tags             Json?
  /// open | expired | removed
  listingStatus    String    @default("open")
  fetchedAt        DateTime  @default(now())
  lastCheckedAt    DateTime  @default(now())

  provider     JobProvider      @relation(fields: [providerSlug], references: [slug], onDelete: Cascade)
  savedBy      SavedJob[]
  matchReports JobMatchReport[]

  @@unique([providerSlug, externalId])
  @@index([fingerprint])
  @@index([listingStatus, postedAt])
  @@index([fetchedAt])
  @@map("api_external_jobs")
}

/// A user's state on one job — either a provider listing or one of their own
/// saved job descriptions (exactly one of the two ids is set). The application
/// record itself stays in JobApplication; this only links to it.
model SavedJob {
  id               String   @id @default(cuid())
  userId           String
  externalJobId    String?
  jobDescriptionId String?
  /// saved | interested | hidden
  state            String   @default("saved")
  notes            String?  @db.Text
  applicationId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalJob    ExternalJob?    @relation(fields: [externalJobId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  application    JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([userId, externalJobId])
  @@unique([userId, jobDescriptionId])
  @@index([userId, state, updatedAt])
  @@map("api_saved_jobs")
}

/// What the user is looking for. One row per user; drives ranking and alerts.
model JobSearchPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  titles            Json     @default("[]")
  skills            Json     @default("[]")
  locations         Json     @default("[]")
  workArrangements  Json     @default("[]")
  employmentTypes   Json     @default("[]")
  experienceLevel   String?
  minSalary         Int?
  salaryCurrency    String?
  excludedCompanies Json     @default("[]")
  keywords          String?
  /// Per-user ranking weight overrides; missing keys fall back to the defaults.
  rankingWeights    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_job_search_preferences")
}

/// A computed resume-to-job match. Recomputed on demand and updated in place for
/// the same (job, resume version) pair; `details` holds the per-dimension
/// evidence so the number can always be explained.
model JobMatchReport {
  id               String   @id @default(cuid())
  userId           String
  externalJobId    String?
  jobDescriptionId String?
  resumeVersionId  String
  matchScore       Int
  label            String
  scoringVersion   String
  details          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalJob    ExternalJob?    @relation(fields: [externalJobId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  resumeVersion  ResumeVersion   @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, externalJobId, resumeVersionId])
  @@unique([userId, jobDescriptionId, resumeVersionId])
  @@index([userId, updatedAt])
  @@map("api_job_match_reports")
}

/// A saved search the user can re-run. Notifications are de-duplicated through
/// UserNotification's (userId, dedupeKey) constraint, so re-running an alert
/// never notifies twice for the same listing.
model JobAlert {
  id              String    @id @default(cuid())
  userId          String
  name            String
  /// Same filter shape as JobSearchPreference, stored per alert.
  query           Json
  /// manual | daily | weekly — only "manual" is actually delivered without a scheduler.
  frequency       String    @default("manual")
  isActive        Boolean   @default(true)
  lastRunAt       DateTime?
  lastResultCount Int       @default(0)
  lastNewCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isActive])
  @@map("api_job_alerts")
}

// ─── Phase 13: application workspace, checklist, cover letters, documents ────

/// One preparation step for an application. Template items carry a stable "key"
/// so the same step is never seeded twice; custom items have a null key.
/// completionSource records whether the app verified the step itself (in_app)
/// or the user is asserting they did it elsewhere (external), because opening
/// an employer's page proves nothing about a submission.
model ApplicationChecklistItem {
  id               String    @id @default(cuid())
  userId           String
  applicationId    String
  key              String?
  title            String
  description      String?
  /// research | resume | cover_letter | documents | interview | submission
  category         String
  isRequired       Boolean   @default(true)
  isCustom         Boolean   @default(false)
  /// in_app | external — null while incomplete
  completionSource String?
  sortOrder        Int       @default(0)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@index([applicationId, sortOrder])
  @@index([userId])
  @@map("api_application_checklist_items")
}

/// A cover letter draft for one application. Versions are kept so a user can
/// compare takes; status stays "draft" until the user approves it, and
/// groundingNotes records what the fabrication guard found.
model CoverLetter {
  id               String   @id @default(cuid())
  userId           String
  applicationId    String
  resumeVersionId  String?
  jobDescriptionId String?
  title            String
  content          String   @db.Text
  /// professional | enthusiastic | concise | formal
  tone             String   @default("professional")
  /// short | standard | detailed
  lengthTarget     String   @default("standard")
  versionNumber    Int      @default(1)
  /// draft | approved
  status           String   @default("draft")
  /// ai | manual | edited
  source           String   @default("ai")
  provider         String?
  model            String?
  groundingNotes   Json?
  wordCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion?        @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  documents     ApplicationDocument[]

  @@unique([applicationId, versionNumber])
  @@index([userId, updatedAt])
  @@map("api_cover_letters")
}

/// A file or link attached to an application. storageKey is an opaque handle
/// into the storage driver and is never returned to the browser; downloads go
/// through an owner-checked endpoint. checksum prevents storing the same bytes
/// twice on one application.
model ApplicationDocument {
  id            String   @id @default(cuid())
  userId        String
  applicationId String
  /// resume | cover_letter | portfolio | certificate | transcript | other
  category      String
  /// file | link
  kind          String   @default("file")
  fileName      String?
  mimeType      String?
  fileSize      Int?
  storageKey    String?
  url           String?
  checksum      String?
  coverLetterId String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  coverLetter CoverLetter?   @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  @@unique([applicationId, checksum])
  @@index([applicationId, category])
  @@index([userId])
  @@map("api_application_documents")
}

/// Audit trail for one application. Every row comes from an operation that
/// actually succeeded; nothing is backfilled for historical records.
/// dedupeKey makes a repeated real event idempotent.
model ApplicationActivity {
  id            String   @id @default(cuid())
  userId        String
  applicationId String
  /// status_changed | resume_selected | cover_letter_created | checklist_completed |
  /// document_added | submitted | interview_scheduled | interview_completed |
  /// follow_up | note | reminder_completed | readiness_review
  type          String
  title         String
  detail        String?  @db.Text
  /// user | system
  source        String   @default("system")
  fromStatus    String?
  toStatus      String?
  dedupeKey     String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, dedupeKey])
  @@index([applicationId, occurredAt])
  @@index([userId, occurredAt])
  @@map("api_application_activities")
}

/// A personal reminder. timezone is the IANA zone the user entered the time in,
/// so a due moment can be shown in their own calendar day. Delivery is in-app:
/// there is no scheduler in this deployment.
model ApplicationReminder {
  id            String    @id @default(cuid())
  userId        String
  applicationId String?
  interviewId   String?
  /// deadline | follow_up | interview | assessment | custom
  type          String
  title         String
  note          String?
  dueAt         DateTime
  timezone      String    @default("UTC")
  /// pending | done | dismissed
  status        String    @default("pending")
  completedAt   DateTime?
  dedupeKey     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   ApplicationInterview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, status, dueAt])
  @@index([applicationId])
  @@map("api_application_reminders")
}

/// A real interview round for an application. Interviewer names are stored only
/// when the user volunteers them; nothing here contacts anyone.
model ApplicationInterview {
  id               String    @id @default(cuid())
  userId           String
  applicationId    String
  /// screening | technical | system_design | behavioral | onsite | final | other
  stage            String
  scheduledAt      DateTime?
  timezone         String?
  durationMinutes  Int?
  /// video | phone | onsite | take_home
  mode             String    @default("video")
  location         String?
  interviewers     Json?
  preparationNotes String?   @db.Text
  /// A Phase 6 mock interview session practised for this round.
  mockSessionId    String?
  /// scheduled | completed | passed | rejected | cancelled | no_response
  outcome          String    @default("scheduled")
  feedback         String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mockSession InterviewSession?     @relation(fields: [mockSessionId], references: [id], onDelete: SetNull)
  reminders   ApplicationReminder[]

  @@index([userId, scheduledAt])
  @@index([applicationId])
  @@map("api_application_interviews")
}

// ─── Phase 14: external integrations & workflow automation ──────────────────

/// One connected (or configured) external service per user. OAuth credentials
/// live in "credentials" as an AES-256-GCM sealed blob produced by tokenVault;
/// the plaintext never reaches the database or any response body. The email
/// integration reuses this row for its preferences and has no credentials.
model ExternalIntegration {
  id                   String    @id @default(cuid())
  userId               String
  /// google_calendar | google_drive | email
  provider             String
  /// connected | expired | disconnected | configured
  status               String    @default("disconnected")
  /// Sealed credential blob: "v1.<iv>.<tag>.<ciphertext>", all base64url.
  credentials          String?
  hasRefreshToken      Boolean   @default(false)
  scopes               Json      @default("[]")
  expiresAt            DateTime?
  connectedAt          DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  /// A label the user recognises (e.g. the connected account's email), never a token.
  externalAccountLabel String?
  /// Per-integration settings: which event types sync, email categories, folder id.
  preferences          Json      @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs       IntegrationSyncLog[]
  calendarEvents ExternalCalendarEvent[]
  fileExports    ExternalFileExport[]

  @@unique([userId, provider])
  @@index([userId, status])
  @@map("api_external_integrations")
}

/// A started OAuth authorization, held until the provider calls back. The state
/// is single-use and short-lived; the PKCE verifier never leaves the backend.
model PendingAuthorization {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  state        String   @unique
  codeVerifier String?
  redirectUri  String
  returnTo     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([expiresAt])
  @@map("api_pending_authorizations")
}

/// Audit trail of consequential external actions: connects, disconnects,
/// refreshes and every event or file this product created at a provider.
model IntegrationSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  userId        String
  /// connect | disconnect | refresh | event_create | event_update | event_delete | drive_create | drive_update
  action        String
  /// ok | warning | error
  status        String
  detail        String?
  externalId    String?
  createdAt     DateTime @default(now())

  integration ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([userId, createdAt])
  @@map("api_integration_sync_logs")
}

/// Links one of our records to the calendar event created for it. This is what
/// makes sync idempotent: a second run finds the row and patches rather than
/// creating a duplicate, and an unchanged contentHash costs no API call.
model ExternalCalendarEvent {
  id              String   @id @default(cuid())
  integrationId   String
  userId          String
  /// interview | deadline | reminder
  sourceKind      String
  sourceId        String
  externalEventId String?
  calendarId      String   @default("primary")
  contentHash     String?
  /// synced | removed
  status          String   @default("synced")
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  integration ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([integrationId, sourceKind, sourceId])
  @@index([userId, status])
  @@map("api_external_calendar_events")
}

/// A document exported to cloud storage, so a repeat export updates the same
/// file instead of leaving near-identical copies in someone's Drive.
model ExternalFileExport {
  id             String   @id @default(cuid())
  integrationId  String
  userId         String
  /// resume_version | cover_letter
  sourceKind     String
  sourceId       String
  externalFileId String
  name           String
  webViewLink    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([integrationId, sourceKind, sourceId])
  @@index([userId])
  @@map("api_external_file_exports")
}

/// A workflow the user switched on, with their configuration. One row per
/// workflow per user.
model AutomationRule {
  id          String    @id @default(cuid())
  userId      String
  /// interview_preparation | application_follow_up | weekly_summary | resume_improvement
  workflowKey String
  isEnabled   Boolean   @default(false)
  config      Json      @default("{}")
  lastRunAt   DateTime?
  lastStatus  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([userId, workflowKey])
  @@index([userId, isEnabled])
  @@map("api_automation_rules")
}

/// One run of a workflow, including what it planned, what the user approved and
/// what each action actually did. Retries point back at the run they repeat.
model AutomationExecution {
  id             String    @id @default(cuid())
  userId         String
  ruleId         String
  /// planned | awaiting_approval | succeeded | partial | failed | skipped
  status         String
  trigger        String?
  plannedActions Json      @default("[]")
  results        Json      @default("[]")
  approved       Boolean   @default(false)
  retryOfId      String?
  retryCount     Int       @default(0)
  nextRetryAt    DateTime?
  /// transient | needs_reconnect
  errorCategory  String?
  createdAt      DateTime  @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ruleId, createdAt])
  @@map("api_automation_executions")
}

/// What was sent, or would have been sent. Unique on (userId, dedupeKey) so a
/// retried workflow can never email twice. Bodies are stored truncated.
model EmailDelivery {
  id        String   @id @default(cuid())
  userId    String
  category  String
  dedupeKey String
  subject   String
  recipient String
  /// delivered | recorded | failed
  status    String
  transport String
  preview   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("api_email_deliveries")
}

// ─── Phase 16: first-run onboarding ────────────────────────────────────────

/// Where a user got to in first-run setup, and nothing else.
///
/// The answers themselves are **not** stored here: career stage, target roles,
/// skills, locations, work mode and goals all already live on `CareerProfile`
/// (Phase 9), and the resume lives on `Resume`/`ResumeVersion`. Duplicating any
/// of it would create a second source of truth for the same facts. This table
/// records only progress, so an interrupted setup can be resumed.
///
/// Step completion is *derived* from real records where it can be — a user who
/// already has a profile and a resume is past those steps whether or not they
/// ever saw this flow. The stored list only records what they explicitly
/// finished or skipped.
model UserOnboarding {
  id String @id @default(cuid())

  userId String @unique

  /// profile | resume | assessment | next_steps | done
  currentStep String @default("profile")

  /// string[] — steps the user explicitly completed
  completedSteps Json

  /// string[] — steps the user chose to skip; they can return to them later
  skippedSteps Json

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Set when the user dismissed the whole flow. The dashboard stops offering
  /// it, but every step remains reachable from Settings.
  dismissedAt DateTime?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_user_onboarding")
}
