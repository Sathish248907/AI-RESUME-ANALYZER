// Backend schema for the AI Resume Analyzer API.
// Table names are mapped with a prefix so this schema can share a database
// with the Next.js (NextAuth) schema without colliding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  analyses          Analysis[]
  resumes           Resume[]
  jobDescriptions   JobDescription[]
  applications      JobApplication[]
  interviewSessions InterviewSession[]

  @@map("api_users")
}

/// An uploaded resume. The extracted text is retained so the resume can be
/// re-analysed against other job descriptions; it is only ever returned to its
/// owner and never to list endpoints. Original files are kept only when a
/// storage driver is configured (STORAGE_DRIVER), referenced by an opaque key.
model Resume {
  id               String   @id @default(cuid())
  userId           String
  name             String
  originalFileName String
  fileType         String
  fileSize         Int
  charCount        Int
  extractedText    String   @db.Text
  targetRole       String?
  storageKey       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  applications JobApplication[]

  @@index([userId, createdAt])
  @@index([userId, name])
  @@map("api_resumes")
}

/// A saved job description that can be reused across resumes and applications.
model JobDescription {
  id                    String   @id @default(cuid())
  userId                String
  jobTitle              String
  companyName           String?
  targetRole            String
  description           String   @db.Text
  sourceUrl             String?
  /// Structured requirements extracted client-side (Phase 3 parser) or by the AI.
  extractedRequirements Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  applications JobApplication[]

  @@index([userId, createdAt])
  @@index([userId, targetRole])
  @@map("api_job_descriptions")
}

/// ResumeAnalysis — one analysis run. Historical runs are preserved; regeneration
/// creates a new row rather than overwriting.
model Analysis {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  jobTitle         String
  targetRole       String
  companyName      String?
  fileName         String?
  analysisMode     String   @default("ai") // "ai" | "demo"
  matchScore       Int
  provider         String?
  model            String?
  /// Validated, structured analysis result (see validators/analysisSchemas.js)
  result           Json
  /// Inputs needed to regenerate the analysis. Resume text is only stored when STORE_RESUME_TEXT=true
  /// and no Resume row is linked.
  jobDescription   String   @db.Text
  resumeText       String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescriptionRef JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  applications   JobApplication[]

  @@index([userId, createdAt])
  @@index([userId, matchScore])
  @@index([userId, targetRole])
  @@index([resumeId])
  @@index([jobDescriptionId])
  @@map("api_analyses")
}

enum ApplicationStatus {
  INTERESTED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id               String            @id @default(cuid())
  userId           String
  jobDescriptionId String?
  resumeId         String?
  analysisId       String?
  companyName      String
  jobTitle         String
  jobUrl           String?
  applicationDate  DateTime          @default(now())
  status           ApplicationStatus @default(INTERESTED)
  nextFollowUpDate DateTime?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  analysis       Analysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, applicationDate])
  @@index([userId, nextFollowUpDate])
  @@index([userId, companyName])
  @@map("api_job_applications")
}

model InterviewSession {
  id                     String    @id @default(cuid())
  userId                 String
  targetRole             String
  interviewType          String    @default("mixed") // technical | hr | coding | resume_based | behavioral | mixed | project
  difficulty             String    @default("intermediate") // beginner | intermediate | advanced
  durationMinutes        Int?
  /// totalQuestions (spec name) — number of generated questions
  questionCount          Int
  /// answeredQuestions (spec name) — answers submitted or skipped
  completedQuestionCount Int       @default(0)
  /// overallScore (spec name) — mean of evaluated answer scores, null until completed
  score                  Int?
  durationSeconds        Int?
  status                 String    @default("in_progress") // in_progress | completed | abandoned
  scoringRubricVersion   String?
  /// Personalisation inputs (ids only; the text is read from the owning rows at generation time)
  analysisId             String?
  resumeId               String?
  jobDescriptionId       String?
  topics                 Json?
  /// Lightweight log entries created from the analysis Interview tab (Phase 5) have source = "practice_log"
  source                 String    @default("mock_interview")
  startedAt              DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]
  answers   InterviewAnswer[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, targetRole])
  @@map("api_interview_sessions")
}

/// A generated question. `evaluationCriteria` is private to the backend and is never
/// returned to the client before the answer has been evaluated.
model InterviewQuestion {
  id                   String   @id @default(cuid())
  sessionId            String
  orderIndex           Int
  questionText         String   @db.Text
  category             String
  topic                String
  difficulty           String
  questionType         String   // conceptual | technical | project | scenario | behavioral | coding
  evaluationCriteria   Json
  suggestedTimeSeconds Int      @default(180)
  createdAt            DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer  InterviewAnswer?

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@map("api_interview_questions")
}

/// The candidate's answer and its evaluation. Deleting the session deletes answers (retention policy:
/// answers live exactly as long as their session; users delete sessions from the interview history).
model InterviewAnswer {
  id                  String    @id @default(cuid())
  sessionId           String
  questionId          String    @unique
  answerText          String    @db.Text
  programmingLanguage String?
  status              String    @default("draft") // draft | submitted | evaluating | evaluated | insufficient | skipped | failed
  evaluationResult    Json?
  score               Int?
  rubricVersion       String?
  submittedAt         DateTime?
  evaluatedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("api_interview_answers")
}
