// Backend schema for the AI Resume Analyzer API.
// Table names are mapped with a prefix so this schema can share a database
// with the Next.js (NextAuth) schema without colliding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  analyses          Analysis[]
  resumes           Resume[]
  jobDescriptions   JobDescription[]
  applications      JobApplication[]
  interviewSessions InterviewSession[]
  roadmaps          LearningRoadmap[]
  skillGaps         SkillGap[]
  dismissals        RecommendationDismissal[]
  resumeVersions    ResumeVersion[]
  templatePreference ResumeTemplatePreference?
  careerProfile     CareerProfile?
  careerAssessments CareerAssessment[]
  careerRecommendations CareerRecommendation[]
  careerActionPlans CareerActionPlan[]
  careerActionTasks CareerActionTask[]
  coachConversations CareerCoachConversation[]

  @@map("api_users")
}

/// An uploaded resume. The extracted text is retained so the resume can be
/// re-analysed against other job descriptions; it is only ever returned to its
/// owner and never to list endpoints. Original files are kept only when a
/// storage driver is configured (STORAGE_DRIVER), referenced by an opaque key.
model Resume {
  id               String   @id @default(cuid())
  userId           String
  name             String
  originalFileName String
  fileType         String
  fileSize         Int
  charCount        Int
  extractedText    String   @db.Text
  targetRole       String?
  storageKey       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  applications JobApplication[]
  versions     ResumeVersion[]

  @@index([userId, createdAt])
  @@index([userId, name])
  @@map("api_resumes")
}

/// A saved job description that can be reused across resumes and applications.
model JobDescription {
  id                    String   @id @default(cuid())
  userId                String
  jobTitle              String
  companyName           String?
  targetRole            String
  description           String   @db.Text
  sourceUrl             String?
  /// Structured requirements extracted client-side (Phase 3 parser) or by the AI.
  extractedRequirements Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  applications JobApplication[]
  resumeVersions ResumeVersion[]

  @@index([userId, createdAt])
  @@index([userId, targetRole])
  @@map("api_job_descriptions")
}

/// ResumeAnalysis — one analysis run. Historical runs are preserved; regeneration
/// creates a new row rather than overwriting.
model Analysis {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  jobTitle         String
  targetRole       String
  companyName      String?
  fileName         String?
  analysisMode     String   @default("ai") // "ai" | "demo"
  matchScore       Int
  provider         String?
  model            String?
  /// Validated, structured analysis result (see validators/analysisSchemas.js)
  result           Json
  /// Inputs needed to regenerate the analysis. Resume text is only stored when STORE_RESUME_TEXT=true
  /// and no Resume row is linked.
  jobDescription   String   @db.Text
  resumeText       String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescriptionRef JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  applications   JobApplication[]

  @@index([userId, createdAt])
  @@index([userId, matchScore])
  @@index([userId, targetRole])
  @@index([resumeId])
  @@index([jobDescriptionId])
  @@map("api_analyses")
}

enum ApplicationStatus {
  INTERESTED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id               String            @id @default(cuid())
  userId           String
  jobDescriptionId String?
  resumeId         String?
  analysisId       String?
  companyName      String
  jobTitle         String
  jobUrl           String?
  applicationDate  DateTime          @default(now())
  status           ApplicationStatus @default(INTERESTED)
  nextFollowUpDate DateTime?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  analysis       Analysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, applicationDate])
  @@index([userId, nextFollowUpDate])
  @@index([userId, companyName])
  @@map("api_job_applications")
}

model InterviewSession {
  id                     String    @id @default(cuid())
  userId                 String
  targetRole             String
  interviewType          String    @default("mixed") // technical | hr | coding | resume_based | behavioral | mixed | project
  difficulty             String    @default("intermediate") // beginner | intermediate | advanced
  durationMinutes        Int?
  /// totalQuestions (spec name) — number of generated questions
  questionCount          Int
  /// answeredQuestions (spec name) — answers submitted or skipped
  completedQuestionCount Int       @default(0)
  /// overallScore (spec name) — mean of evaluated answer scores, null until completed
  score                  Int?
  durationSeconds        Int?
  status                 String    @default("in_progress") // in_progress | completed | abandoned
  scoringRubricVersion   String?
  /// Personalisation inputs (ids only; the text is read from the owning rows at generation time)
  analysisId             String?
  resumeId               String?
  jobDescriptionId       String?
  topics                 Json?
  /// Lightweight log entries created from the analysis Interview tab (Phase 5) have source = "practice_log"
  source                 String    @default("mock_interview")
  startedAt              DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]
  answers   InterviewAnswer[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, targetRole])
  @@map("api_interview_sessions")
}

/// A generated question. `evaluationCriteria` is private to the backend and is never
/// returned to the client before the answer has been evaluated.
model InterviewQuestion {
  id                   String   @id @default(cuid())
  sessionId            String
  orderIndex           Int
  questionText         String   @db.Text
  category             String
  topic                String
  difficulty           String
  questionType         String   // conceptual | technical | project | scenario | behavioral | coding
  evaluationCriteria   Json
  suggestedTimeSeconds Int      @default(180)
  createdAt            DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer  InterviewAnswer?

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@map("api_interview_questions")
}

/// The candidate's answer and its evaluation. Deleting the session deletes answers (retention policy:
/// answers live exactly as long as their session; users delete sessions from the interview history).
model InterviewAnswer {
  id                  String    @id @default(cuid())
  sessionId           String
  questionId          String    @unique
  answerText          String    @db.Text
  programmingLanguage String?
  status              String    @default("draft") // draft | submitted | evaluating | evaluated | insufficient | skipped | failed
  evaluationResult    Json?
  score               Int?
  rubricVersion       String?
  submittedAt         DateTime?
  evaluatedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("api_interview_answers")
}

// ─── Phase 7: Learning roadmap & skill gaps ──────────────────────────────────

/// A generated learning plan. Regeneration creates a new version row and marks the
/// previous one `superseded` (its id is kept in previousVersionId for history).
model LearningRoadmap {
  id                       String    @id @default(cuid())
  userId                   String
  targetRole               String
  title                    String
  objective                String    // job_readiness | interview_prep | project_development | skill_improvement
  currentSkillLevel        String    // beginner | intermediate | advanced
  weeklyStudyHours         Int
  preferredSchedule        String    @default("flexible") // weekdays | weekends | flexible
  preferredFormat          String    @default("mixed")    // documentation | tutorials | exercises | projects | mixed
  targetCompletionDate     DateTime?
  estimatedHours           Int       @default(0)
  estimatedWeeks           Int       @default(0)
  status                   String    @default("active") // active | archived | superseded
  version                  Int       @default(1)
  previousVersionId        String?
  changeSummary            Json?
  skillGapSummary          Json?
  sourceResumeId           String?
  sourceJobDescriptionId   String?
  sourceAnalysisId         String?
  sourceInterviewSessionIds Json?
  provider                 String?
  model                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones RoadmapMilestone[]
  skillGaps  SkillGap[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("api_learning_roadmaps")
}

model RoadmapMilestone {
  id                    String    @id @default(cuid())
  roadmapId             String
  sequenceNumber        Int
  title                 String
  description           String    @db.Text
  requiredSkills        Json      // string[]
  learningObjectives    Json      // string[]
  estimatedHours        Int       @default(0)
  /// sequenceNumbers of milestones that must be completed first (validated to reference earlier milestones)
  prerequisiteSequences Json      // number[]
  completionCriteria    String    @db.Text
  status                String    @default("not_started") // locked | not_started | in_progress | completed
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  roadmap LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks   LearningTask[]

  @@unique([roadmapId, sequenceNumber])
  @@index([roadmapId, status])
  @@map("api_roadmap_milestones")
}

model LearningTask {
  id                 String    @id @default(cuid())
  milestoneId        String
  sequenceNumber     Int
  title              String
  description        String    @db.Text
  skillName          String
  taskType           String    // learn_concept | read_docs | tutorial | coding_exercise | mini_project | review_interview_questions | explain_concept | knowledge_checkpoint
  difficulty         String    @default("intermediate")
  estimatedMinutes   Int       @default(30)
  isRequired         Boolean   @default(true)
  scheduledDate      DateTime?
  completionCriteria String    @db.Text
  status             String    @default("not_started") // not_started | in_progress | paused | completed | skipped
  notes              String?   @db.Text
  actualStudyMinutes Int       @default(0)
  /// For knowledge_checkpoint tasks: { id, type: mcq|conceptual|coding|project|checklist, passScore?, questions?[...], items?[...] }.
  /// Correct answers are stripped before being sent to the client until an attempt is submitted.
  checkpoint         Json?
  checkpointAttempts Json?     // attempt history [{ at, score, passed, answers }]
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  milestone RoadmapMilestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  resources LearningResource[]

  @@unique([milestoneId, sequenceNumber])
  @@index([milestoneId, status])
  @@index([scheduledDate])
  @@map("api_learning_tasks")
}

/// Resources attached to a task. URLs are only stored when they come from the verified
/// catalog (`urlVerified = true`); otherwise only a title / search suggestion is kept.
model LearningResource {
  id           String   @id @default(cuid())
  taskId       String
  title        String
  resourceType String   // official_docs | tutorial | video_course | practice_platform | project_example | interview_prep | search_suggestion
  url          String?
  urlVerified  Boolean  @default(false)
  provider     String   @default("third_party") // official | third_party | search
  description  String   @db.Text
  difficulty   String   @default("intermediate")
  createdAt    DateTime @default(now())

  task LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("api_learning_resources")
}

/// Persistent per-user skill status, refreshed whenever a roadmap is generated and
/// editable by the user ("I already know this").
model SkillGap {
  id                String    @id @default(cuid())
  userId            String
  roadmapId         String?
  skillName         String
  category          String
  proficiencyStatus String    // demonstrated | needs_improvement | not_demonstrated | not_assessed | learning_in_progress
  priority          String    // high | medium | low
  priorityScore     Int       @default(0)
  evidenceSources   Json      // string[]
  explanation       String    @db.Text
  whyItMatters      String    @db.Text
  targetProficiency String    @default("working")
  relatedTopics     Json?     // string[]
  userConfirmed     Boolean   @default(false)
  userNote          String?
  lastAssessedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap LearningRoadmap? @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@unique([userId, skillName])
  @@index([userId, priorityScore])
  @@map("api_skill_gaps")
}

model RecommendationDismissal {
  id                String   @id @default(cuid())
  userId            String
  recommendationKey String
  dismissedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationKey])
  @@map("api_recommendation_dismissals")
}

// ─── Phase 8: resume builder ───────────────────────────────────────────────

/// An editable, structured resume. The uploaded file and its extracted text on
/// `Resume` are never modified; every edit lives on a version. `content` holds
/// the ordered sections (see services/resumeBuilder/resumeContentSchema.js) and
/// `formatting` the template options. Searchable metadata stays in columns.
model ResumeVersion {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  parentVersionId  String?
  name             String
  versionNumber    Int
  kind             String   @default("custom") // original | improved | tailored | custom | restored
  isOriginal       Boolean  @default(false)
  templateId       String   @default("modern")
  content          Json
  formatting       Json
  contentSource    String   @default("manual") // manual | heuristic | ai | duplicate | restore
  targetJobTitle   String?
  targetCompany    String?
  lastQualityScore Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  improvements   ResumeImprovement[]

  @@index([userId, updatedAt])
  @@index([resumeId, versionNumber])
  @@map("api_resume_versions")
}

/// One AI suggestion for one field. Suggestions are stored separately from the
/// resume content and only reach the content when the user accepts them.
model ResumeImprovement {
  id            String   @id @default(cuid())
  versionId     String
  batchId       String
  mode          String   // improve | tailor
  sectionId     String
  entryId       String?
  field         String   // summary | bullet:<index> | title | skills | ...
  category      String   // clarity | impact | grammar | keywords | structure | relevance
  originalText  String   @db.Text
  suggestedText String   @db.Text
  rationale     String   @db.Text
  needsConfirmation Boolean @default(false)
  confirmationQuestion String?
  status        String   @default("pending") // pending | accepted | rejected | edited
  acceptedText  String?  @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, batchId])
  @@index([versionId, status])
  @@map("api_resume_improvements")
}

/// The user's default template and formatting for new versions.
model ResumeTemplatePreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  templateId String   @default("modern")
  formatting Json
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_resume_template_preferences")
}

// ─── Phase 9: career coach ─────────────────────────────────────────────────

/// What the user tells us about their goals. Nothing here is inferred.
model CareerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  careerLevel       String   @default("fresher") // student | fresher | junior | mid | experienced
  targetRoles       Json     // string[]
  industries        Json     // string[]
  skills            Json     // string[] — self-declared, kept separate from evidence-based skill gaps
  locations         Json     // string[]
  workMode          String   @default("any") // remote | hybrid | onsite | any
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  goals             String?  @db.Text
  learningInterests Json     // string[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_career_profiles")
}

/// A readiness assessment for one target role. Scores are derived from records (method versioned).
model CareerAssessment {
  id              String   @id @default(cuid())
  userId          String
  targetRole      String
  overallScore    Int
  readinessLabel  String
  components      Json     // [{ key, label, weight, score, evidence[], missing[] }]
  skills          Json     // [{ skillName, status, score, evidence[] }]
  strengths       Json     // string[]
  improvements    Json     // string[]
  missingEvidence Json     // string[]
  nextActions     Json     // [{ title, href, reason }]
  sources         Json     // { resumes, analyses, interviews, roadmaps, applications, versions }
  method          String
  createdAt       DateTime @default(now())

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations CareerRecommendation[]

  @@index([userId, createdAt])
  @@index([userId, targetRole])
  @@map("api_career_assessments")
}

/// Evidence-backed recommendation with completion state. `key` is stable so regeneration updates instead of duplicating.
model CareerRecommendation {
  id             String   @id @default(cuid())
  userId         String
  assessmentId   String?
  key            String
  type           String   // resume | interview | learning | project | application | skill | profile
  title          String
  explanation    String   @db.Text
  reason         String   @db.Text
  evidence       Json     // string[]
  priority       String   @default("medium") // high | medium | low
  effortMinutes  Int?
  href           String
  status         String   @default("open") // open | done | dismissed
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment CareerAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([userId, status, priority])
  @@map("api_career_recommendations")
}

model CareerActionPlan {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  weekEnd     DateTime
  status      String   @default("active") // active | archived
  targetRole  String?
  summary     Json     // { totalMinutes, byCategory, sources }
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks CareerActionTask[]

  @@index([userId, status])
  @@index([userId, weekStart])
  @@map("api_career_action_plans")
}

model CareerActionTask {
  id               String    @id @default(cuid())
  planId           String
  userId           String
  title            String
  description      String?   @db.Text
  category         String    // learning | interview | resume | application | personal
  href             String?
  estimatedMinutes Int       @default(30)
  dueDate          DateTime?
  isOptional       Boolean   @default(false)
  sourceKey        String?   // recommendation key / roadmap task id / application id — prevents duplicates across regenerations
  status           String    @default("pending") // pending | done | skipped
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plan CareerActionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@index([userId, dueDate])
  @@map("api_career_action_tasks")
}

model CareerCoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CareerCoachMessage[]

  @@index([userId, updatedAt])
  @@map("api_career_coach_conversations")
}

model CareerCoachMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant
  content        String   @db.Text
  factsUsed      Json?    // string[] — recorded facts the reply relied on
  suggestions    Json?    // string[] — AI-generated suggestions (not facts)
  links          Json?    // [{ label, path }]
  clarifying     Boolean  @default(false)
  provider       String?
  model          String?
  createdAt      DateTime @default(now())

  conversation CareerCoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("api_career_coach_messages")
}
