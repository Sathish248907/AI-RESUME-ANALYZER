    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^1.4.4",
    "pdf-parse": "^1.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
